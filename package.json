{
  "name": "dsh-comfyui-link",
  "version": "1.15.0",
  "description": "DSH 的 ComfyUI 桥：12 个工具直连本机 ComfyUI，支持按任务反查本机能力 / 文生图 / 图生图 / LoRA / 算法放大 / 自带工作流 / 工作流分析器（识别关键节点、连线、可改参数、诊断与子图）/ 持久化工作流知识库（学习、检索、复用并按真实运行经验完善），并可指定审图模型看后把关、不满自动重画；自带「绘图模式」预设，输入框左侧可选生图模型与 LoRA；LoRA 提示词文档可指定目录，挂 LoRA 时自动并入 prompt",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "stable-diffusion",
    "image-generation",
    "txt2img",
    "img2img",
    "lora",
    "upscale",
    "workflow",
    "workflow-inspector",
    "workflow-learning",
    "agent-preset"
  ],
  "license": "MIT",
  "author": "dsh-comfyui-link contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jx70/dsh-comfyui-link.git"
  },
  "homepage": "https://github.com/jx70/dsh-comfyui-link#readme",
  "bugs": {
    "url": "https://github.com/jx70/dsh-comfyui-link/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/config.test.mjs test/registration.test.mjs test/capabilities.test.mjs test/graph.test.mjs test/offline-k35.test.mjs test/polling-k37.test.mjs test/output.test.mjs test/picker.test.mjs test/lora-docs.test.mjs test/format-adapter.test.mjs test/inspector.test.mjs test/workspace-view.test.mjs test/workflow-knowledge-store.test.mjs test/learning.test.mjs test/security.test.mjs",
    "smoke": "node scripts/offline.mjs",
    "smoke:live": "node scripts/offline.mjs --live",
    "e2e": "node scripts/e2e.mjs",
    "selftest": "node scripts/selftest.mjs",
    "probe:route": "node scripts/probe-route.mjs",
    "probe:http": "node scripts/probe-http.mjs",
    "probe:features": "node scripts/probe-features.mjs",
    "probe:bundle": "node scripts/probe-client-bundle.mjs",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-github.ps1"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1",
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
